    <!-- Core Identification -->
    <rdf:Description rdf:about="https://www.tnopsi.com/dslo/v0.8/surfaces/federated">
      <dc:title>DSLO v0.8 — Federated Geometry Surface</dc:title>
      <dc:creator>DSLO Discipline — Federated Geometry Working Group</dc:creator>
      <dc:publisher>TNOPSI Institute</dc:publisher>
      <dct:identifier>10.5281/zenodo.22180977</dct:identifier>
      <dct:issued>2026-09-16</dct:issued>
