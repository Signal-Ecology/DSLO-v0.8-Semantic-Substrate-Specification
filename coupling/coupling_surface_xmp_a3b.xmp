    <!-- Core Identification -->
    <rdf:Description rdf:about="https://www.tnopsi.com/dslo/v0.8/surfaces/coupling">
      <dc:title>DSLO v0.8 — Coupling Geometry Surface</dc:title>
      <dc:creator>Inda Moment Incorporated</dc:creator>
      <dc:publisher>TNOPSI Institute</dc:publisher>
      <dct:identifier>10.5281/zenodo.coupling.v0.8.placeholder</dct:identifier>
