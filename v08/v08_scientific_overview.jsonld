  "dslo:scientificSummary": {
    "federatedGeometry": "v0.8 introduces federated geometry, enabling lawful multi-agent, multi-domain, and multi-ecology thermodynamic modeling.",
    "domainLayer": "v0.8 defines a 30-domain, 5-meta-class geometry system for cross-domain classification.",
    "invariantLayer": "v0.8 stabilizes invariant families, continuity bands, and legality envelopes.",
    "mappingLayer": "v0.8 defines lawful cross-surface mapping geometry for geometry, domain, invariant, and registry surfaces.",
    "registryLayer": "v0.8 establishes registry anchors, continuity rules, and lawful lineage declarations.",
    "formattingLayer": "v0.8 introduces DSLO-native formatting surfaces for stable machine ingestion."
  },

  "dslo:scientificClaims": [
    "v0.8 extends DSLO from individual thermodynamic geometry to collective thermodynamic geometry.",
    "v0.8 preserves all v0.7 invariants and legality envelopes.",
    "v0.8 introduces no substrate modifications.",
    "v0.8 introduces no physics or substrate-skin.",
    "v0.8 is forward-compatible but not forward-referential."
  ],

