    <!-- Scientific Summary -->
    <rdf:Description rdf:about="">
      <dslo:scientificSummary>
        <rdf:Description>
          <dslo:federatedGeometry>v0.8 introduces federated geometry enabling lawful multi-agent, multi-domain, and multi-ecology thermodynamic modeling.</dslo:federatedGeometry>
          <dslo:domainLayer>v0.8 defines a 30-domain, 5-meta-class geometry system for cross-domain classification.</dslo:domainLayer>
          <dslo:invariantLayer>v0.8 stabilizes invariant families, continuity bands, and legality envelopes.</dslo:invariantLayer>
          <dslo:mappingLayer>v0.8 defines lawful cross-surface mapping geometry for geometry, domain, invariant, and registry surfaces.</dslo:mappingLayer>
          <dslo:registryLayer>v0.8 establishes registry anchors, continuity rules, and lawful lineage declarations.</dslo:registryLayer>
          <dslo:formattingLayer>v0.8 introduces DSLO-native formatting surfaces for stable machine ingestion.</dslo:formattingLayer>
        </rdf:Description>
      </dslo:scientificSummary>
    </rdf:Description>

    <!-- Scientific Claims -->
    <rdf:Description rdf:about="">
      <dslo:scientificClaims rdf:parseType="Collection">
        <rdf:Description>v0.8 extends DSLO from individual thermodynamic geometry to collective thermodynamic geometry.</rdf:Description>
        <rdf:Description>v0.8 preserves all v0.7 invariants and legality envelopes.</rdf:Description>
        <rdf:Description>v0.8 introduces no substrate modifications.</rdf:Description>
        <rdf:Description>v0.8 introduces no physics or substrate-skin.</rdf:Description>
        <rdf:Description>v0.8 is forward-compatible but not forward-referential.</rdf:Description>
      </dslo:scientificClaims>
    </rdf:Description>

    <!-- Continuity Rules -->
    <rdf:Description rdf:about="">
      <dslo:continuityRules rdf:parseType="Collection">
        <rdf:Description>v0.8 inherits exclusively from v0.7</rdf:Description>
        <rdf:Description>v0.8 is geometry-only</rdf:Description>
        <rdf:Description>v0.8 is strictly additive</rdf:Description>
        <rdf:Description>v0.8 does not modify substrate</rdf:Description>
        <rdf:Description>v0.8 does not introduce physics</rdf:Description>
        <rdf:Description>v0.8 does not reference v0.9</rdf:Description>
        <rdf:Description>v0.8 does not reference sibling v0.8 artifacts</rdf:Description>
        <rdf:Description>v0.8 maintains invariant-preserving vocabulary</rdf:Description>
      </dslo:continuityRules>
    </rdf:Description>

