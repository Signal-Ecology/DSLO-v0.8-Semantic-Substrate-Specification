    <rdf:Description rdf:about="https://www.tnopsi.com/dslo/v0.8/scientific-overview">
      <dc:title>DSLO v0.8 — Scientific Overview</dc:title>
      <dc:creator>DSLO Discipline — Federated Geometry Working Group</dc:creator>
      <dc:publisher>TNOPSI Institute</dc:publisher>
      <dct:identifier>10.5281/zenodo.22181245</dct:identifier>
      <dct:issued>2026-09-16</dct:issued>
      <dc:language>en</dc:language>
      <dc:rights>CC-BY 4.0</dc:rights>
