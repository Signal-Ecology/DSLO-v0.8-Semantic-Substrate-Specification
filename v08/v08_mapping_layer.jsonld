  "dslo:mappingSurfaces": [
    {
      "id": "MS1",
      "label": "geometry → domain mapping",
      "description": "Defines lawful mapping between geometry primitives and domain-class envelopes."
    },
    {
      "id": "MS2",
      "label": "geometry → invariant mapping",
      "description": "Defines invariant-preserving mapping between geometry curvature envelopes and invariant families."
    },
    {
      "id": "MS3",
      "label": "geometry → ecology mapping",
      "description": "Defines lawful mapping between geometry surfaces and thermodynamic ecology geometry."
    },
    {
      "id": "MS4",
      "label": "geometry → frontier mapping",
      "description": "Defines mapping geometry for frontier surfaces without introducing runtime behavior."
    },
    {
      "id": "MS5",
      "label": "geometry → teaching mapping",
      "description": "Defines lawful mapping between geometry surfaces and teaching vectors."
    }
  ],

  "dslo:mappingOperators": [
    {
      "operator": "M-GD",
      "description": "Geometry-to-Domain Mapping Operator",
      "requirements": [
        "invariant_preserved",
        "identity_boundary_clear",
        "manifold_legal"
      ]
    },
    {
      "operator": "M-GI",
      "description": "Geometry-to-Invariant Mapping Operator",
