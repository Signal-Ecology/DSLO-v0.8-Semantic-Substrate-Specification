      "requirements": [
        "ecology_envelope_stable",
        "drift_channel_lawful"
      ]
    },
    {
      "operator": "M-GF",
      "description": "Geometry-to-Frontier Mapping Operator",
      "requirements": [
        "frontier_boundary_clear",
        "mapping_non_runtime"
      ]
    },
    {
      "operator": "M-GT",
      "description": "Geometry-to-Teaching Mapping Operator",
      "requirements": [
        "teaching_vector_stable",
        "identity_preserved"
      ]
    }
  ],

  "dslo:mappingRules": [
    "Mapping surfaces must remain non-runtime and non-agentic.",
    "Mapping may not modify geometry curvature or domain envelopes.",
    "All mapping outputs must serialize cleanly into DSLO-native formats.",
    "Mapping drift may not propagate into ecology or frontier surfaces.",
    "Mapping must remain descriptive, not predictive.",
    "All legality envelopes must remain within lawful constraints.",
    "Mapping surfaces must preserve DOI lineage and geometry invariants."
  ],

