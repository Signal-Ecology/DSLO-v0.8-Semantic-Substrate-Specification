    <!-- Invariant Status -->
    <rdf:Description rdf:about="">
      <dslo:invariantStatus>
        <rdf:Description>
          <dslo:substrateNeutral>true</dslo:substrateNeutral>
          <dslo:invariantPreserving>true</dslo:invariantPreserving>
          <dslo:lawful>true</dslo:lawful>
          <dslo:nonReconstructible>true</dslo:nonReconstructible>
          <dslo:publicLayerSafe>true</dslo:publicLayerSafe>
        </rdf:Description>
      </dslo:invariantStatus>
    </rdf:Description>

    <!-- Continuity Rules -->
    <rdf:Description rdf:about="">
      <dslo:continuityRules rdf:parseType="Collection">
        <rdf:Description>v0.8 inherits exclusively from v0.7</rdf:Description>
        <rdf:Description>v0.8 is geometry-only</rdf:Description>
        <rdf:Description>v0.8 is strictly additive</rdf:Description>
        <rdf:Description>v0.8 does not modify substrate</rdf:Description>
        <rdf:Description>v0.8 does not introduce physics</rdf:Description>
        <rdf:Description>v0.8 does not reference v0.9</rdf:Description>
        <rdf:Description>v0.8 does not reference sibling v0.8 artifacts</rdf:Description>
        <rdf:Description>v0.8 maintains invariant-preserving vocabulary</rdf:Description>
      </dslo:continuityRules>
    </rdf:Description>

