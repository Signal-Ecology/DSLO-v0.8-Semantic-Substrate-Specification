  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
           xmlns:dc="http://purl.org/dc/elements/1.1/"
           xmlns:dct="http://purl.org/dc/terms/"
           xmlns:dslo="https://www.tnopsi.com/dslo/schema#"
           xmlns:prov="http://www.w3.org/ns/prov#"
           xmlns:zenodo="https://zenodo.org/ns/">

    <!-- Core Identification -->
    <rdf:Description rdf:about="https://www.tnopsi.com/dslo/v0.8/collection">
      <dc:title>DSLO v0.8 — Federated Geometry Collection</dc:title>
      <dc:publisher>Zenodo</dc:publisher>
      <dct:issued>2026-09-16</dct:issued>
      <dc:creator>DSLO Discipline — Federated Geometry Working Group</dc:creator>
      <dc:language>en</dc:language>
      <dc:rights>CC-BY 4.0</dc:rights>
    </rdf:Description>

    <!-- Abstract -->
    <rdf:Description rdf:about="">
      <dc:description>
        DSLO v0.8 is the federated geometry expansion of the DSLO discipline. 
        This collection contains all geometry-only artifacts included in the v0.8 release. 
        v0.8 inherits exclusively from DSLO v0.7 substrate and manifold lineage, 
        is strictly additive, invariant-preserving, substrate-neutral, and does not reference v0.9, physics, substrate-skin, or Umbrella 12.
      </dc:description>
    </rdf:Description>

