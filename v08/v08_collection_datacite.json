  "descriptions": [
    {
      "description": "The DSLO v0.8 Federated Geometry Collection contains all geometry-only artifacts included in the v0.8 release. This collection inherits exclusively from DSLO v0.7 substrate and manifold lineage, and provides the federated geometry surfaces required for multi-agent, multi-domain, and multi-ecology systems. v0.8 is strictly additive, invariant-preserving, substrate-neutral, and does not reference v0.9, physics, substrate-skin, or Umbrella 12.",
      "descriptionType": "Abstract"
    }
  ],

