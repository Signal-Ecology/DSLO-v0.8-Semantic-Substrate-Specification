    <rdf:Description rdf:about="https://www.tnopsi.com/dslo/v0.8/surfaces/identity">
      <dc:title>DSLO v0.8 — Identity Geometry Surface</dc:title>
      <dc:creator>DSLO Discipline — Federated Geometry Working Group</dc:creator>
      <dc:publisher>TNOPSI Institute</dc:publisher>
      <dct:identifier>10.5281/zenodo.22180818</dct:identifier>
