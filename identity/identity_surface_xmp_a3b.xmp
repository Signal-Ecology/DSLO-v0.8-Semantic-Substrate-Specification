        <rdf:Description>Identity Preservation Invariants</rdf:Description>
      </dslo:invariantFamilies>
    </rdf:Description>

    <!-- Continuity Bands -->
    <rdf:Description rdf:about="">
      <dslo:continuityBands rdf:parseType="Collection">
